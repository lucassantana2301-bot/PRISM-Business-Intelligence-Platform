{
  "name": "prism-platform",
  "version": "0.1.0",
  "private": true,
  "description": "PRISM — Business Intelligence Platform: Ask. Understand. Decide.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "build": "npm --workspace=apps/web run build",
    "lint": "npm --workspace=apps/web run lint",
    "typecheck": "npm --workspace=apps/web run typecheck",
    "test": "npm --workspace=apps/web run test",
    "generate:data": "npx tsx apps/web/scripts/generate_dataset.ts",
    "validate:data": "npx tsx apps/web/scripts/validate_dataset.ts",
    "test:analytics": "npx tsx apps/web/scripts/test_analytics_engine.ts",
    "test:dashboard": "npx tsx apps/web/scripts/test_dashboard_integration.ts",
    "test:explorer": "npx tsx apps/web/scripts/test_explorer_integration.ts",
    "test:ask": "npx tsx apps/web/scripts/test_ask_prism.ts",
    "test:visualization": "npx tsx apps/web/scripts/test_visualization.ts",
    "test:voice": "npx tsx apps/web/scripts/test_voice.ts"
  },
  "keywords": [
    "business-intelligence",
    "analytics",
    "data-intelligence",
    "ai",
    "nl-to-sql",
    "prism"
  ],
  "author": "PRISM Team",
  "license": "UNLICENSED"
}
